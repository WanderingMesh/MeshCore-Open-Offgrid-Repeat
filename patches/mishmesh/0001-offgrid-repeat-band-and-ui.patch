+// --- Stale-panel clobber -----------------------------------------------------
+// The panel is a singleton that stays on the applet stack while the screen
+// sleeps, and AppletHost pops it on wake (popToRoot -> onStop -> onHide). If it
+// commits its whole staged struct, a config changed meanwhile over the companion
+// link -- i.e. from the phone app -- is silently overwritten. Only fields the
+// user actually touched may be written back.
+
+TEST(RadioPanel, OnHideDoesNotClobberFieldsChangedElsewhere) {
+  FakeRadioApp app;
+  app.cfg = {915.8f, 250.0f, 10, 5, 20, false};
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);                 // stages 915.8
+
+  panel.stageSf(9);                 // user edits SF only -> panel is dirty
+
+  app.cfg.freqMhz = 911.0f;         // phone app retunes while the panel sits stacked
+
+  panel.onHide();                   // wake-triggered pop commits the panel
+  EXPECT_FLOAT_EQ(911.0f, app.cfg.freqMhz);   // app's change must survive
+  EXPECT_EQ(9, app.cfg.sf);                   // the edit the user made still lands
+}
+
+TEST(RadioPanel, ConfirmingKeypadWithoutChangingDoesNotDirty) {
+  FakeRadioApp app;
+  app.cfg = {915.8f, 250.0f, 10, 5, 20, false};
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);
+  panel.stageFrequency(915.8f);     // keypad confirmed with the value unchanged
+  panel.onHide();
+  EXPECT_EQ(0, app.setCalls);       // nothing to write -> no apply at all
+}
+
+TEST(RadioPanel, OnShowRefreshesWhenCleanAndPreservesPendingEdit) {
+  FakeRadioApp app;
+  app.cfg = {915.8f, 250.0f, 10, 5, 20, false};
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);
+
+  app.cfg.freqMhz = 911.0f;         // changed externally while backgrounded
+  panel.onShow();                   // clean panel -> pick the new value up
+  EXPECT_FLOAT_EQ(911.0f, panel.stagedConfig().freqMhz);
+
+  panel.stageFrequency(910.525f);   // pending edit
+  app.cfg.freqMhz = 918.0f;         // another external change
+  panel.onShow();                   // returning from a sub-applet must not discard it
+  EXPECT_FLOAT_EQ(910.525f, panel.stagedConfig().freqMhz);
+}
+
+TEST(RadioPanel, EditingFrequencyRetiresStaleRepeatRestoreTarget) {
+  FakeRadioApp app;
+  app.cfg = {915.8f, 250.0f, 10, 5, 20, false};
+  app.savedFreq = 911.0f;           // left over from an earlier repeat session
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);
+  panel.stageFrequency(910.525f);
+  panel.onHide();
+  EXPECT_FLOAT_EQ(910.525f, app.cfg.freqMhz);
+  EXPECT_FLOAT_EQ(0.0f, app.savedFreq);   // cleared, so "Off" cannot snap back to 911
+}
+
+TEST(RadioPanel, EnablingRepeatRecordsCommittedPreRepeatFrequency) {
+  FakeRadioApp app;
+  app.cfg = {910.525f, 62.5f, 7, 5, 20, false};
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);
+  panel.stageFrequency(918.0f);     // what the Repeater picker's preset row stages
+  panel.stageRepeater(true);
+  panel.onHide();
+  EXPECT_TRUE(app.cfg.repeater);
+  EXPECT_FLOAT_EQ(918.0f, app.cfg.freqMhz);
+  EXPECT_FLOAT_EQ(910.525f, app.savedFreq);   // the frequency we were actually on
+}
+
+TEST(RadioPanel, DisablingRepeatClearsRestoreTarget) {
+  FakeRadioApp app;
+  app.cfg = {918.0f, 62.5f, 7, 5, 20, true};
+  app.savedFreq = 910.525f;
+  mishmesh::RadioSettingsPanel& panel = mishmesh::radioSettings();
+  auto ctx = ctxWith(&app);
+  panel.begin(ctx);
+  panel.stageFrequency(910.525f);   // ROW_OFF stages the restore, then disables
+  panel.stageRepeater(false);
+  panel.onHide();
+  EXPECT_FALSE(app.cfg.repeater);
+  EXPECT_FLOAT_EQ(910.525f, app.cfg.freqMhz);
+  EXPECT_FLOAT_EQ(0.0f, app.savedFreq);   // consumed; no stale target left behind
+}
