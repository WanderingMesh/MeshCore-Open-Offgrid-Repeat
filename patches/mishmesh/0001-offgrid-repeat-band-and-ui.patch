+  FakeApp app; FakeTgt tgt;
+  tgt.cfg = {918.0f, 250.0f, 10, 5, 20, true};   // repeating on a preset
+  AppletContext ctx = ctxWith(&app, &tgt);
+  RepeaterApplet& a = repeaterApplet();
+  a.onStart(ctx);
+  EXPECT_FALSE(a.radioOn(RepeaterApplet::ROW_CURRENT));
