+  EXPECT_TRUE(tgt.cfg.repeater);
+  EXPECT_FLOAT_EQ(915.8f, tgt.cfg.freqMhz);   // unchanged
+  EXPECT_FLOAT_EQ(915.8f, app.saved);         // restore target is the same freq
+  EXPECT_TRUE(a.radioOn(RepeaterApplet::ROW_CURRENT));
